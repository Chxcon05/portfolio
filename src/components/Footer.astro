---
import { ArrowUp, Github, Linkedin, Mail } from 'lucide-astro';
import { navLinks, site, socialLinks } from '../data/site';

const icons = { github: Github, linkedin: Linkedin, mail: Mail };
const year = new Date().getFullYear();
---

<footer class="border-t border-line">
  <div class="container-page py-10 sm:py-12">
    <div class="flex flex-col gap-8 md:flex-row md:items-start md:justify-between">
      <div class="max-w-sm">
        <a href="#inicio" class="inline-flex items-center gap-2.5 rounded-lg">
          <span class="grid size-8 place-items-center rounded-lg border border-line-strong bg-elevated font-mono text-[13px] font-semibold text-fg">
            {site.shortName}
          </span>
          <span class="text-sm font-medium text-fg">{site.name}</span>
        </a>
        <p class="mt-4 text-sm leading-relaxed text-muted">
          Gracias por pasar. Sigo aprendiendo y construyendo; si algo de aquí te sirve, hablemos.
        </p>
      </div>

      <div class="flex gap-12">
        <nav aria-label="Secciones">
          <p class="eyebrow mb-3">Secciones</p>
          <ul class="grid gap-2 text-sm">
            {
              navLinks.map((link) => (
                <li>
                  <a href={link.href} class="text-muted transition-colors hover:text-fg">
                    {link.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>

        <div>
          <p class="eyebrow mb-3">En línea</p>
          <ul class="grid gap-2 text-sm">
            {
              socialLinks.map((link) => {
                const Icon = icons[link.icon];
                const external = !link.href.startsWith('mailto:');
                return (
                  <li>
                    <a
                      href={link.href}
                      {...(external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
                      class="inline-flex items-center gap-2 text-muted transition-colors hover:text-fg"
                    >
                      <Icon size={14} aria-hidden="true" />
                      {link.label}
                    </a>
                  </li>
                );
              })
            }
          </ul>
        </div>
      </div>
    </div>

    <div class="mt-10 flex flex-col-reverse gap-4 border-t border-line pt-6 font-mono text-xs text-subtle sm:flex-row sm:items-center sm:justify-between">
      <p>
        © <span data-year>{year}</span> {site.name} · Hecho con Astro y Tailwind CSS
      </p>
      <a href="#inicio" class="group inline-flex items-center gap-1.5 transition-colors hover:text-fg">
        Volver arriba
        <ArrowUp size={13} class="transition-transform group-hover:-translate-y-0.5" aria-hidden="true" />
      </a>
    </div>
  </div>
</footer>
