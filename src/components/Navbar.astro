---
import { Command, Github, Menu, Moon, Sun, X } from 'lucide-astro';
import { githubUrl, navLinks, site } from '../data/site';
---

<header class="fixed inset-x-0 top-3 z-50 px-4 sm:top-4">
  <nav
    data-navbar
    aria-label="Principal"
    class="mx-auto max-w-3xl rounded-md border border-line bg-bg/70 shadow-[0_8px_30px_-12px_rgb(0_0_0/0.35)] backdrop-blur-xl transition-[border-color,background-color] duration-300 data-[scrolled=true]:border-line-strong data-[scrolled=true]:bg-bg/85"
  >
    <div class="flex h-14 items-center justify-between gap-2 pr-2 pl-3">
      <a href="#inicio" class="group flex items-center gap-2.5 rounded-lg" aria-label={`${site.name}, ir al inicio`}>
        <span
          class="grid size-8 place-items-center rounded-sm bg-accent pb-0.5 font-serif text-lg leading-none font-medium text-accent-fg italic transition-transform duration-300 group-hover:-rotate-6"
        >
          {site.shortName}
        </span>
        <span class="hidden text-sm font-medium tracking-tight text-fg sm:inline">{site.name}</span>
      </a>

      <ul class="hidden items-center gap-1 md:flex">
        {
          navLinks.map((link) => (
            <li>
              <a
                href={link.href}
                data-nav-link
                class="relative px-3 py-1.5 text-sm text-muted transition-colors after:absolute after:inset-x-3 after:bottom-0.5 after:h-px after:origin-left after:scale-x-0 after:bg-accent after:transition-transform after:duration-300 hover:text-fg hover:after:scale-x-100 aria-[current=true]:text-fg aria-[current=true]:after:scale-x-100"
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>

      <div class="flex items-center gap-1.5">
        <button
          type="button"
          data-palette-open
          aria-label="Abrir paleta de comandos (Ctrl + K)"
          aria-keyshortcuts="Control+K Meta+K"
          class="flex h-9 items-center gap-1.5 rounded-sm px-2 text-muted transition-colors hover:bg-elevated hover:text-fg"
        >
          <Command size={16} aria-hidden="true" />
          <kbd class="hidden font-mono text-[11px] lg:inline" data-palette-kbd>Ctrl K</kbd>
        </button>

        <button
          type="button"
          data-theme-toggle
          aria-label="Cambiar a tema claro"
          class="grid size-9 place-items-center rounded-full text-muted transition-colors hover:bg-elevated hover:text-fg"
        >
          <Sun size={17} class="hidden dark:block" aria-hidden="true" />
          <Moon size={17} class="block dark:hidden" aria-hidden="true" />
        </button>

        <a
          href={githubUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-primary h-9 px-3.5"
        >
          <Github size={16} aria-hidden="true" />
          <span class="hidden sm:inline">GitHub</span>
          <span class="sr-only sm:hidden">Perfil de GitHub</span>
        </a>

        <button
          type="button"
          data-menu-toggle
          aria-expanded="false"
          aria-controls="mobile-menu"
          aria-label="Abrir menú"
          class="group grid size-9 place-items-center rounded-full text-muted transition-colors hover:bg-elevated hover:text-fg md:hidden"
        >
          <Menu size={18} class="group-aria-expanded:hidden" aria-hidden="true" />
          <X size={18} class="hidden group-aria-expanded:block" aria-hidden="true" />
        </button>
      </div>
    </div>

    <div id="mobile-menu" data-menu hidden class="border-t border-line px-2 py-2 md:hidden">
      <ul class="grid gap-0.5">
        {
          navLinks.map((link, index) => (
            <li>
              <a
                href={link.href}
                class="flex items-center justify-between rounded-sm px-3 py-2.5 text-[15px] text-muted transition-colors hover:bg-elevated hover:text-fg"
              >
                {link.label}
                <span class="font-mono text-[11px] text-subtle">0{index + 1}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </nav>
</header>
