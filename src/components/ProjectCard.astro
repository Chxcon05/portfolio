---
import { ArrowUpRight, Github } from 'lucide-astro';
import ProjectMockup from './ProjectMockup.astro';
import { categories, type Project } from '../data/projects';
import { withBase } from '../lib/url';

interface Props {
  project: Project;
  index: number;
}

const { project, index } = Astro.props;
const featured = project.featured === true;
const headingId = `project-${project.slug}`;
---

<article
  data-project
  data-spotlight
  data-tilt
  data-category={project.category}
  data-reveal
  aria-labelledby={headingId}
  style={`--reveal-delay:${(index % 3) * 70}ms`}
  class:list={['card card-hover group flex flex-col overflow-hidden', featured && 'md:col-span-2']}
>
  <div class:list={['relative border-b border-line', featured ? 'aspect-[16/10] md:aspect-[21/9]' : 'aspect-[16/10]']}>
    {
      project.image ? (
        <img
          src={withBase(project.image)}
          alt={project.imageAlt ?? `Captura de ${project.title}`}
          loading="lazy"
          decoding="async"
          class="tilt-3d h-full w-full object-cover object-top transition-transform duration-500"
        />
      ) : (
        <ProjectMockup variant={project.mockup} slug={project.slug} title={project.title} />
      )
    }
    <span class="tilt-glare" aria-hidden="true"></span>
    {
      featured && (
        <span class="absolute top-3 right-3 rotate-2 rounded-sm bg-accent-2 px-2.5 py-1 font-mono text-[10px] font-semibold tracking-wider text-accent-2-fg uppercase shadow-[2px_2px_0_0_var(--fg)]">
          Destacado
        </span>
      )
    }
  </div>

  <div class="flex flex-1 flex-col p-5 sm:p-6">
    <div class="flex items-center justify-between gap-3 font-mono text-[11px] tracking-[0.1em] text-subtle uppercase">
      <span class="flex items-center gap-2"><span class="text-accent">N.º {String(index + 1).padStart(2, '0')}</span><span class="text-line-strong">/</span>{categories[project.category]}</span>
      <span>{project.year}</span>
    </div>

    <h3 id={headingId} class:list={['mt-3 font-serif leading-tight font-normal tracking-[-0.01em] text-fg', featured ? 'text-2xl sm:text-4xl' : 'text-2xl']}>{project.title}</h3>
    <p class="mt-2 text-sm leading-relaxed text-pretty text-muted">{project.description}</p>

    {
      project.highlights && project.highlights.length > 0 && (
        <ul class="mt-4 grid gap-1.5 text-sm text-muted md:grid-cols-3 md:gap-3">
          {project.highlights.map((highlight) => (
            <li class="flex gap-2">
              <span class="mt-[0.45rem] size-1.5 shrink-0 rotate-45 bg-accent-2" aria-hidden="true" />
              <span>{highlight}</span>
            </li>
          ))}
        </ul>
      )
    }

    <ul class="mt-5 flex flex-wrap gap-1.5" aria-label="Tecnologías">
      {project.stack.map((tech) => <li class="tag">{tech}</li>)}
    </ul>

    <div class="flex-1 pt-5" aria-hidden="true"></div>
    <div class="flex flex-wrap items-center gap-x-5 gap-y-2 border-t border-dashed border-line-strong pt-4 text-sm">
      <a
        href={project.repo}
        target="_blank"
        rel="noopener noreferrer"
        class="arrow-link inline-flex items-center gap-1.5 font-medium text-fg transition-colors hover:text-accent"
      >
        <Github size={15} aria-hidden="true" />
        Código
        <span class="sr-only">de {project.title} en GitHub</span>
      </a>
      {
        project.demo && (
          <a
            href={project.demo}
            target="_blank"
            rel="noopener noreferrer"
            class="arrow-link inline-flex items-center gap-1 font-medium text-fg transition-colors hover:text-accent"
          >
            Live Demo
            <ArrowUpRight size={15} aria-hidden="true" />
            <span class="sr-only">de {project.title}</span>
          </a>
        )
      }
    </div>
  </div>
</article>
