---
interface Props {
  index: string;
  eyebrow: string;
  title: string;
  description?: string;
  id?: string;
}

const { index, eyebrow, title, description, id } = Astro.props;
---

<div class="mb-10 sm:mb-14" data-reveal>
  <div class="mb-6 flex items-center gap-4 font-mono text-xs tracking-[0.14em] text-subtle uppercase">
    <span>{eyebrow}</span>
    <span class="h-px flex-1 bg-line-strong" aria-hidden="true"></span>
    <span aria-hidden="true">§ {index}</span>
  </div>

  <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
    <div class="flex max-w-3xl items-start gap-4 sm:gap-6">
      <span
        class="text-outline -mt-1 shrink-0 font-serif text-6xl leading-none font-light italic sm:-mt-2 sm:text-8xl"
        aria-hidden="true"
      >
        {index}
      </span>
      <div class="min-w-0">
        <h2 id={id} class="font-serif text-3xl leading-[1.08] font-normal tracking-[-0.02em] text-balance text-fg sm:text-5xl">
          {title}
        </h2>
        {description && <p class="mt-4 max-w-2xl text-base leading-relaxed text-pretty text-muted">{description}</p>}
      </div>
    </div>
    <slot />
  </div>
</div>
