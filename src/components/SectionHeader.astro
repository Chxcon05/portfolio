---
interface Props {
  index: string;
  eyebrow: string;
  title: string;
  description?: string;
  id?: string;
}

const { index, eyebrow, title, description, id } = Astro.props;
---

<div class="mb-8 flex flex-col gap-6 sm:mb-10 md:flex-row md:items-end md:justify-between" data-reveal>
  <div class="max-w-2xl">
    <p class="eyebrow mb-3">
      <span class="text-accent">{index}</span>
      <span class="mx-1.5 text-line-strong">/</span>
      {eyebrow}
    </p>
    <h2 id={id} class="text-3xl font-semibold tracking-tight text-balance text-fg sm:text-4xl">{title}</h2>
    {description && <p class="mt-3 text-base leading-relaxed text-pretty text-muted">{description}</p>}
  </div>
  <slot />
</div>
