---
/**
 * Mockup decorativo dibujado con CSS para proyectos sin captura.
 * Cuando tengas una captura real, añade `image` al proyecto en
 * src/data/projects.ts y este componente dejará de usarse para él.
 */
import { CloudSun } from 'lucide-astro';
import type { MockupVariant } from '../data/projects';

interface Props {
  variant: MockupVariant;
  slug: string;
  title: string;
}

const { variant, slug, title } = Astro.props;

const bars = [38, 62, 45, 80, 56, 92, 70, 84];
const days = ['L', 'M', 'K', 'J', 'V'];
const isWindow = variant !== 'mobile';
---

<div
  class="relative h-full w-full overflow-hidden bg-elevated"
  role="img"
  aria-label={`Vista ilustrativa de ${title}`}
>
  <div class="bg-grid absolute inset-0 opacity-60 [mask-image:none]" aria-hidden="true"></div>

  {
    isWindow ? (
      <div
        aria-hidden="true"
        class="absolute inset-x-5 top-5 bottom-0 flex flex-col overflow-hidden rounded-t-xl border border-b-0 border-line-strong bg-surface shadow-[0_-10px_40px_-20px_rgb(0_0_0/0.5)] transition-transform duration-500 ease-[cubic-bezier(0.22,1,0.36,1)] group-hover:-translate-y-1.5 sm:inset-x-7 sm:top-7"
      >
        <div class="flex h-7 shrink-0 items-center gap-1.5 border-b border-line px-3">
          <span class="size-2 rounded-full bg-line-strong" />
          <span class="size-2 rounded-full bg-line-strong" />
          <span class="size-2 rounded-full bg-line-strong" />
          <span class="ml-2 truncate rounded bg-elevated px-2 font-mono text-[9px] leading-4 text-subtle">
            {variant === 'desktop' ? `${title} — Menú principal` : `chxcon05/${slug}`}
          </span>
        </div>

        <div class="flex min-h-0 flex-1 gap-3 p-3">
          {variant === 'dashboard' && (
            <>
              <div class="hidden w-1/5 shrink-0 flex-col gap-1.5 sm:flex">
                <span class="h-2 w-3/4 rounded-sm bg-accent/70" />
                <span class="h-2 w-full rounded-sm bg-line-strong" />
                <span class="h-2 w-5/6 rounded-sm bg-line" />
                <span class="h-2 w-2/3 rounded-sm bg-line" />
                <span class="h-2 w-4/5 rounded-sm bg-line" />
              </div>
              <div class="flex min-w-0 flex-1 flex-col gap-2.5">
                <div class="grid grid-cols-3 gap-2">
                  {['128', '42', '18%'].map((value) => (
                    <div class="rounded-md border border-line p-2">
                      <span class="block h-1.5 w-1/2 rounded-sm bg-line-strong" />
                      <span class="mt-1.5 block font-mono text-[11px] font-semibold text-fg">{value}</span>
                    </div>
                  ))}
                </div>
                <div class="flex min-h-0 flex-1 items-end gap-1.5 rounded-md border border-line p-2">
                  {bars.map((height, index) => (
                    <span
                      class:list={['flex-1 rounded-t-sm', index === 5 ? 'bg-accent' : 'bg-line-strong']}
                      style={`height:${height}%`}
                    />
                  ))}
                </div>
                <div class="flex flex-col gap-1.5">
                  <span class="h-2 w-full rounded-sm bg-line" />
                  <span class="h-2 w-11/12 rounded-sm bg-line" />
                </div>
              </div>
            </>
          )}

          {variant === 'report' && (
            <div class="flex min-w-0 flex-1 flex-col gap-2.5">
              <div class="flex items-center justify-between">
                <span class="h-2 w-1/3 rounded-sm bg-line-strong" />
                <span class="rounded border border-line px-1.5 font-mono text-[9px] leading-4 text-subtle">PDF · XLSX</span>
              </div>
              <div class="relative min-h-0 flex-1 rounded-md border border-line">
                <svg viewBox="0 0 200 80" preserveAspectRatio="none" class="absolute inset-0 h-full w-full">
                  <polyline
                    points="0,62 25,55 50,58 75,40 100,44 125,28 150,32 175,18 200,22"
                    fill="none"
                    stroke="var(--accent)"
                    stroke-width="2"
                    vector-effect="non-scaling-stroke"
                  />
                  <polyline
                    points="0,70 25,66 50,64 75,60 100,58 125,52 150,50 175,46 200,44"
                    fill="none"
                    stroke="var(--line-strong)"
                    stroke-width="1.5"
                    stroke-dasharray="4 4"
                    vector-effect="non-scaling-stroke"
                  />
                </svg>
              </div>
              <div class="grid grid-cols-4 gap-1.5">
                {[0, 1, 2, 3].map((cell) => (
                  <span class:list={['h-2 rounded-sm', cell === 3 ? 'bg-accent/60' : 'bg-line']} />
                ))}
              </div>
            </div>
          )}

          {variant === 'store' && (
            <div class="flex min-w-0 flex-1 flex-col gap-2.5">
              <div class="flex items-center justify-between">
                <span class="h-2 w-1/4 rounded-sm bg-line-strong" />
                <span class="flex items-center gap-1 rounded-full border border-line px-1.5 font-mono text-[9px] leading-4 text-subtle">
                  carrito <span class="text-accent">3</span>
                </span>
              </div>
              <div class="grid min-h-0 flex-1 grid-cols-4 gap-2">
                {[0, 1, 2, 3].map((item) => (
                  <div class="flex flex-col gap-1.5 rounded-md border border-line p-1.5">
                    <span class:list={['min-h-0 flex-1 rounded-sm', item === 1 ? 'bg-accent/25' : 'bg-elevated']} />
                    <span class="h-1.5 w-3/4 rounded-sm bg-line-strong" />
                    <span class="font-mono text-[9px] text-muted">${(item + 2) * 10 - 1}</span>
                  </div>
                ))}
              </div>
            </div>
          )}

          {variant === 'learning' && (
            <div class="flex min-w-0 flex-1 flex-col gap-2">
              <div class="flex items-center gap-2">
                <span class="font-mono text-[9px] text-subtle">Pregunta 4/10</span>
                <span class="h-1.5 flex-1 overflow-hidden rounded-full bg-line">
                  <span class="block h-full w-2/5 rounded-full bg-accent" />
                </span>
              </div>
              <span class="h-2.5 w-4/5 rounded-sm bg-line-strong" />
              {['A', 'B', 'C'].map((option) => (
                <div
                  class:list={[
                    'flex items-center gap-2 rounded-md border px-2 py-1.5',
                    option === 'B' ? 'border-accent bg-accent/10' : 'border-line',
                  ]}
                >
                  <span class:list={['font-mono text-[9px]', option === 'B' ? 'text-accent' : 'text-subtle']}>{option}</span>
                  <span class="h-1.5 w-2/3 rounded-sm bg-line-strong" />
                </div>
              ))}
            </div>
          )}

          {variant === 'weather' && (
            <div class="flex min-w-0 flex-1 flex-col justify-between gap-2">
              <div class="flex items-start justify-between">
                <div>
                  <span class="block h-1.5 w-16 rounded-sm bg-line-strong" />
                  <span class="mt-1.5 block font-mono text-3xl leading-none font-semibold tracking-tight text-fg">24°</span>
                </div>
                <CloudSun size={34} stroke-width={1.5} class="text-accent" />
              </div>
              <div class="grid grid-cols-5 gap-1.5">
                {days.map((day, index) => (
                  <div class="flex flex-col items-center gap-1 rounded-md border border-line py-1.5">
                    <span class="font-mono text-[9px] text-subtle">{day}</span>
                    <span class="font-mono text-[10px] text-fg">{[23, 25, 21, 22, 26][index]}°</span>
                  </div>
                ))}
              </div>
            </div>
          )}

          {variant === 'chat' && (
            <div class="flex min-w-0 flex-1 flex-col justify-end gap-1.5 font-mono text-[9px] leading-snug">
              <p class="max-w-[75%] self-end rounded-lg rounded-br-sm bg-accent/15 px-2 py-1 text-fg">
                ¿Velocidad en zona escolar?
              </p>
              <p class="max-w-[80%] self-start rounded-lg rounded-bl-sm border border-line px-2 py-1 text-muted">
                Máximo 25 km/h si hay presencia de niños.
              </p>
              <p class="max-w-[60%] self-end rounded-lg rounded-br-sm bg-accent/15 px-2 py-1 text-fg">
                ¿Y en una rotonda?
              </p>
              <div class="mt-1 flex items-center gap-1 rounded-md border border-line px-2 py-1 text-subtle">
                <span class="text-accent">&gt;</span> escribe tu pregunta_
              </div>
            </div>
          )}

          {variant === 'desktop' && (
            <div class="flex min-w-0 flex-1 gap-3">
              <div class="flex w-2/5 flex-col gap-1.5">
                {['Nombre', 'Especie', 'Cuidador'].map((field) => (
                  <div>
                    <span class="font-mono text-[8px] text-subtle">{field}</span>
                    <span class="block h-3 rounded-sm border border-line bg-elevated" />
                  </div>
                ))}
                <span class="mt-auto h-3.5 w-1/2 rounded-sm bg-accent/70" />
              </div>
              <div class="flex min-w-0 flex-1 flex-col overflow-hidden rounded-md border border-line">
                <div class="grid grid-cols-3 gap-1 border-b border-line bg-elevated px-1.5 py-1">
                  <span class="h-1.5 rounded-sm bg-line-strong" />
                  <span class="h-1.5 rounded-sm bg-line-strong" />
                  <span class="h-1.5 rounded-sm bg-line-strong" />
                </div>
                {[0, 1, 2, 3].map((row) => (
                  <div class:list={['grid grid-cols-3 gap-1 px-1.5 py-1', row === 1 && 'bg-accent/10']}>
                    <span class="h-1.5 rounded-sm bg-line" />
                    <span class="h-1.5 rounded-sm bg-line" />
                    <span class="h-1.5 rounded-sm bg-line" />
                  </div>
                ))}
              </div>
            </div>
          )}
        </div>
      </div>
    ) : (
      <div
        aria-hidden="true"
        class="absolute top-5 bottom-0 left-1/2 flex w-[42%] max-w-44 -translate-x-1/2 flex-col overflow-hidden rounded-t-[1.4rem] border border-b-0 border-line-strong bg-surface p-2.5 pb-0 transition-transform duration-500 ease-[cubic-bezier(0.22,1,0.36,1)] group-hover:-translate-y-1.5 sm:top-7"
      >
        <span class="mx-auto mb-2.5 h-1.5 w-10 shrink-0 rounded-full bg-line-strong" />
        <div class="mb-2 flex items-center justify-between">
          <span class="h-2 w-1/2 rounded-sm bg-line-strong" />
          <span class="grid size-4 place-items-center rounded-full bg-accent font-mono text-[9px] leading-none text-accent-fg">+</span>
        </div>
        <div class="flex flex-col gap-1.5">
          {[0, 1, 2, 3].map((thread) => (
            <div class="rounded-md border border-line p-1.5">
              <span class:list={['block h-1.5 rounded-sm', thread === 0 ? 'w-3/4 bg-accent/60' : 'w-2/3 bg-line-strong']} />
              <span class="mt-1 block h-1 w-full rounded-sm bg-line" />
              <span class="mt-1 block font-mono text-[8px] text-subtle">{(thread + 1) * 3} comentarios</span>
            </div>
          ))}
        </div>
      </div>
    )
  }
</div>
